{
  "name": "@soch-tokenomics/tokenomics-dsh-plugin",
  "version": "2.4.0",
  "description": "Tokenomics agentic-efficiency suite: compress agent prose, minimize code generation, track token savings, token budget, gamification, subagent propagation. Inspired by caveman and ponytail, engineered independently.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "apply.js",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "Souvik Chakraborty <souvikchakraborty@souvik.local>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/z99wE/tokenomics-plugin.git"
  },
  "keywords": [
    "dsh-plugin",
    "tokenomics",
    "ai-agent",
    "token-compression",
    "prose-compression",
    "code-minimization",
    "gamification",
    "agentic-efficiency",
    "deepseek-harness"
  ],
  "category": "Tools & Capabilities",
  "profile": "web",
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.0",
    "python": ">=3.9.0"
  },
  "scripts": {
    "test": "python3 -m unittest tokenomics.tests.test_core tokenomics.tests.test_hermes tokenomics.tests.test_cli",
    "lint": "python3 -m ruff check .",
    "install:python": "pip install tokenomics",
    "start": "node index.mjs"
  },
  "dependencies": {},
  "devDependencies": {}
}
